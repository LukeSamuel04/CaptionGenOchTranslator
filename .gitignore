# =========================
# 项目指定忽略项
# =========================
# 忽略虚拟环境目录
.venv/

# 忽略静态资源与模型大文件
assets/

# =========================
# 业务动态生成与缓存文件 (新增)
# =========================
# 动态生成的字幕输出目录
output_captions/
output_captions_test/

# 业务运行时产生的临时缓存
.caption_cache/

# =========================
# Python 缓存与临时文件
# =========================
__pycache__/
*.py[cod]
*$py.class
*.log
*.tmp
.pytest_cache/

# =========================
# IDE 与操作系统文件
# =========================
# JetBrains 系列 (如 PyCharm, Fleet 等)
.idea/

# VS Code
.vscode/

# 操作系统缓存文件
.DS_Store
Thumbs.db