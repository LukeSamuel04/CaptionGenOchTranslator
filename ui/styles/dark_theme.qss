/* ==========================================
   全局底色与文本色 (Dark Theme)
   ========================================== */
QWidget {
    color: #E0E0E0; /* 取消全局背景色，仅保留全局文字颜色 */
}

/* [核心修改] 精准给页面底板上色 */
#DownloadPage, #workspacePage {
    background-color: #1E1E1E;
}

/* ==========================================
   悬浮提示框 (QToolTip) - 深色配色
   ========================================== */
QToolTip {
    background-color: #2D2D30;
    color: #E0E0E0;
    border: 1px solid #555555;
}

/* ==========================================
   通用红叉按钮 (CloseXButton) - 常态配色
   ========================================== */
#CloseXButton {
    color: #A0A0A0;
}

/* ==========================================
   通用毛玻璃卡片容器 (glassContainer) - 深色玻璃材质
   ========================================== */
QFrame#glassContainer { /* [核心修改] 补全 QFrame */
    background-color: rgba(45, 45, 45, 150);
    border: 1px solid rgba(0, 120, 215, 60);
}

/* ==========================================
   下载页面滚动条 (DownloadPage) - 深色环境滑块
   ========================================== */
#downloadScrollArea QScrollBar::handle:vertical,
#downloadScrollArea QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 30);
}

#downloadScrollArea QScrollBar::handle:vertical:hover,
#downloadScrollArea QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 120, 215, 150);
}
/* ==========================================
   SettingCard (通用设置卡片) 深色调色板
   ========================================== */

/* 亮灰色标题 */
#settingCardTitle {
    color: #E0E0E0;
}

/* 降低不透明度的白灰分割线 */
#settingCardSeparator {
    color: rgba(255, 255, 255, 30);
    background-color: rgba(255, 255, 255, 30);
}